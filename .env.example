# ── Bek Rate Desk — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your real values.
# .env is git-ignored and must NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Basic-auth credentials for the web UI
TRADING_APP_USER=your_username_here
TRADING_APP_PASS=your_password_here

# FRED API key — get one free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# TCMB EVDS API key — request at https://evds2.tcmb.gov.tr
TCMB_EVDS_KEY=your_tcmb_evds_key_here

# Flask / gunicorn (Railway injects PORT automatically)
# PORT=5001
